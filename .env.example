# Environment Variables Example
# Copy this file to .env and replace the values with your actual secrets

# Environment (development, test, production)
NODE_ENV=production
PORT=3000

# Next.js URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database Configuration (PostgreSQL in Docker)
DATABASE_URL="postgresql://postgres:postgres@db:5432/gbp_growth_pro?schema=public"

# Redis Configuration (For Queues / Caching)
REDIS_URL="redis://redis:6379"

# Security
JWT_SECRET="generate_a_secure_random_string_here_for_production"
JWT_EXPIRES_IN="7d"

# Google Business Profile / OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Meta / WhatsApp API
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"

# Stripe (Payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# AI Providers (At least one required for AI features)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."

# Email (SMTP or Resend)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="noreply@yourdomain.com"

# Logging Level
LOG_LEVEL=info
